# GNSS options for the Titan 2 on top of arm64 defconfig + configs/mainline-titan2.config of
# titan2-tools (https://github.com/Serlk/titan2-tools), for the gnss branch of titan2-linux.
# The GNSS data link of CONNSYS (mtk-gps-dl: the character devices the GNSS daemon opens);
# CONFIG_GNSS and CONFIG_MTK_CONNINFRA are already set by mainline-titan2.config
CONFIG_MTK_GPS_DL=m
