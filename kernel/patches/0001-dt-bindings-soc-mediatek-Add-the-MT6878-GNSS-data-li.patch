From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: serlk <22211586+Serlk@users.noreply.github.com>
Date: Thu, 12 Nov 2026 18:23:42 +0300
Subject: [PATCH 1/3] dt-bindings: soc: mediatek: Add the MT6878 GNSS data link

The GNSS DSPs (L1 and L5) of the MT6878 CONNSYS: the node the boot loader
completes with the GNSS EMI address, the CONNSYS windows it shares with
CONNINFRA, Wi-Fi and BT, and its interrupts.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../soc/mediatek/mediatek,mt6878-gps.yaml     | 95 +++++++++++++++++++
 1 file changed, 95 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6878-gps.yaml

diff --git a/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6878-gps.yaml b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6878-gps.yaml
new file mode 100644
index 000000000000..577dd096c3aa
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/mediatek/mediatek,mt6878-gps.yaml
@@ -0,0 +1,95 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/mediatek/mediatek,mt6878-gps.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: MediaTek MT6878 GNSS data link
+
+maintainers:
+  - serlk <22211586+Serlk@users.noreply.github.com>
+
+description:
+  The AP side of the two GNSS DSPs (L1, L5) of the MT6878 connectivity
+  subsystem. Their power, DMA and mailbox registers are driven by the
+  trusted firmware; the node gives the register windows the kernel still
+  reads, the seven interrupts and the GNSS EMI region, whose address the
+  boot loader writes into the node.
+
+properties:
+  compatible:
+    const: mediatek,mt6878-gps
+
+  reg:
+    minItems: 3
+    maxItems: 6
+
+  reg-names:
+    minItems: 3
+    items:
+      - const: conn_gps_base
+      - const: conn_infra_base
+      - const: status_dummy_cr
+      - const: tia2_gps_on
+      - const: tia2_gps_rc_sel
+      - const: tia2_gps_debug
+
+  interrupts:
+    items:
+      - description: L1 DSP has data
+      - description: L1 DSP has no more data
+      - description: L1 DSP mailbox
+      - description: L5 DSP has data
+      - description: L5 DSP has no more data
+      - description: L5 DSP mailbox
+      - description: DMA done
+
+  mediatek,conninfra:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: The CONNINFRA node that powers the subsystem.
+
+  emi-addr:
+    $ref: /schemas/types.yaml#/definitions/uint64
+    description: Physical address of the GNSS EMI region, written by the boot loader.
+
+  emi-size:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  emi-alignment:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  emi-max-addr:
+    $ref: /schemas/types.yaml#/definitions/uint32
+
+  b13b14-status-addr:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Address of the modem band status word reported to user space.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - interrupts
+  - mediatek,conninfra
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    gps@18c00000 {
+        compatible = "mediatek,mt6878-gps";
+        reg = <0x18c00000 0x100000>, <0x18000000 0x100000>, <0x1c000000 0x4>;
+        reg-names = "conn_gps_base", "conn_infra_base", "status_dummy_cr";
+        interrupts = <GIC_SPI 379 IRQ_TYPE_LEVEL_HIGH 0>,
+                     <GIC_SPI 380 IRQ_TYPE_LEVEL_HIGH 0>,
+                     <GIC_SPI 381 IRQ_TYPE_LEVEL_HIGH 0>,
+                     <GIC_SPI 382 IRQ_TYPE_LEVEL_HIGH 0>,
+                     <GIC_SPI 383 IRQ_TYPE_LEVEL_HIGH 0>,
+                     <GIC_SPI 389 IRQ_TYPE_LEVEL_HIGH 0>,
+                     <GIC_SPI 129 IRQ_TYPE_LEVEL_HIGH 0>;
+        mediatek,conninfra = <&consys>;
+        emi-size = <0x100000>;
+    };
-- 
